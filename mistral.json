{
  "schemaVersion": 1,
  "modules": [
    {
      "type": "app",
      "name": "picnic",
      "path": "modules/picnic",
      "routes": [
        {
          "path": "/mcp",
          "mcp": true
        },
        {
          "path": "/health"
        }
      ],
      "port": 3000,
      "serve": "server",
      "runtime": "node",
      "build": {
        "context": "modules/picnic",
        "dockerfile": "Dockerfile"
      },
      "dev": {
        "startCommand": "npm ci --ignore-scripts --no-audit --no-fund && npm run build && node bin/mcp-server.js --enable-http --http-host 0.0.0.0 --http-port \"${PORT:-3000}\""
      },
      "deploy": {
        "startCommand": "node bin/mcp-server.js --enable-http --http-host 0.0.0.0 --http-port \"${PORT:-3000}\""
      }
    }
  ]
}
