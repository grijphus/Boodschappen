{
  "schemaVersion": 2,
  "kind": "app",
  "name": "github__grijphus__Boodschappen",
  "deployment": {
    "organizationId": "00d98343-519f-432f-ad0a-4251154d646d",
    "workspaceId": "c95d8d34-15cc-4ad9-8e41-0a35b6a40881",
    "appId": "01a1ca23-4720-7611-acca-f6d91e9df2fd"
  },
  "modules": [
    {
      "type": "app",
      "name": "picnic",
      "path": "modules/picnic",
      "routes": [
        {
          "path": "/mcp",
          "mcp": true
        },
        {
          "path": "/health"
        }
      ],
      "port": 3000,
      "serve": "server",
      "runtime": "node",
      "build": {
        "context": "modules/picnic",
        "dockerfile": "Dockerfile"
      },
      "dev": {
        "startCommand": "npm ci --ignore-scripts --no-audit --no-fund && npm run build && node bin/mcp-server.js --enable-http --http-host 0.0.0.0 --http-port \"${PORT:-3000}\""
      },
      "deploy": {
        "startCommand": "node bin/mcp-server.js --enable-http --http-host 0.0.0.0 --http-port \"${PORT:-3000}\""
      }
    }
  ]
}
